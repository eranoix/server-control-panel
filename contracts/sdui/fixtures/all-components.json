{
  "sdui_version": 1,
  "screen": {
    "id": "fixture.all",
    "title": "All components",
    "components": [
      {
        "type": "table",
        "id": "containers-table",
        "columns": [
          { "key": "name", "label": "Name", "kind": "text" },
          {
            "key": "status",
            "label": "Status",
            "kind": "badge",
            "badge_map": { "running": "success", "exited": "neutral" }
          }
        ],
        "rows_source": { "endpoint": "/api/mobile/v1/docker/containers", "method": "GET" },
        "row_actions": [
          { "action_id": "container.restart" },
          { "action_id": "container.kill" }
        ],
        "empty_state": { "text": "No running containers" }
      },
      {
        "type": "form",
        "id": "notify-rule-form",
        "fields": [
          { "key": "name", "label": "Rule name", "kind": "text", "required": true },
          {
            "key": "channel",
            "label": "Channel",
            "kind": "select",
            "options_source": { "endpoint": "/api/mobile/v1/notify/channels" }
          }
        ],
        "submit_action": { "action_id": "notify.rule.create" }
      },
      {
        "type": "list",
        "id": "notify-inbox",
        "item_template": "notification_card",
        "rows_source": { "endpoint": "/api/mobile/v1/notify/inbox" }
      },
      {
        "type": "detail",
        "id": "container-detail",
        "data_source": { "endpoint": "/api/mobile/v1/docker/containers/{id}" },
        "fields": [
          { "key": "image", "label": "Image" },
          { "key": "created_at", "label": "Created at", "kind": "datetime" }
        ]
      },
      {
        "type": "action",
        "id": "deploy-trigger",
        "label": "Deploy",
        "action_id": "deploy.trigger",
        "style": "primary"
      },
      {
        "type": "chart",
        "id": "cpu-chart",
        "chart_kind": "line",
        "series_source": { "endpoint": "/api/mobile/v1/system/history?metric=cpu" },
        "x_key": "ts",
        "y_key": "value"
      },
      {
        "type": "confirm_destructive",
        "id": "kill-container-confirm",
        "action_id": "container.kill",
        "message": "This will kill the container permanently.",
        "require_typed_confirmation": "my-container"
      }
    ]
  }
}
