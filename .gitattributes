# Language stats: Linguist guesses wrong in both directions here. It drops our
# own code that lives under a vendor/ directory, and it would count generated
# files and third-party templates as hand-written.

# Third party, shipped in-tree so the binary works offline
internal/webassets/web/vendor/**                    linguist-vendored=true
browser/public/uv/**                                linguist-vendored=true
android/*/vendor/**                                 linguist-vendored=true

# openapi-generator template, copied only to add a missing import upstream.
android/data/mobile-api-client/openapi-templates/** linguist-vendored=true

# Ours; it lives under vendor/ because the asset server reads from there.
# Must come AFTER the rule above: in git the last matching pattern wins.
internal/webassets/web/vendor/panel/**               linguist-vendored=false

# Generated
internal/webassets/web/tailwind.css                 linguist-generated=true
*.min.js                                            linguist-generated=true
# VT session captures used as terminal engine fixtures (escape sequences).
*.vt                                                linguist-generated=true

# Hand-written files that Linguist classifies as `data` and would hide
*.gradle.kts                                        linguist-detectable=true
*.xml                                               linguist-detectable=true

# ProGuard rules: Linguist has confused `.pro` with Prolog.
*.pro                                               linguist-detectable=false
