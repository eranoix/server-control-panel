# /etc/systemd/system/vpsm-whatsapp.service
#
# Wraps `docker compose up/down` for the WAHA gateway. Installed by
# scripts/whatsapp/install.sh.
#
# StartLimitBurst/IntervalSec mirror vps-manager.service so a broken WAHA
# image doesn't loop indefinitely — systemd surfaces it in `systemctl status`.

[Unit]
Description=vps-manager WhatsApp gateway (WAHA + GOWS)
Documentation=https://github.com/devlikeapro/waha
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vpsm-whatsapp
EnvironmentFile=/opt/vpsm-whatsapp/.env
ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180
# Bound restart attempts so a broken image stops looping — visible in
# `systemctl status` instead of churning CPU forever.
StartLimitBurst=5
StartLimitIntervalSec=60

[Install]
WantedBy=multi-user.target
