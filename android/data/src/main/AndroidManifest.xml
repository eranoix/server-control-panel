<?xml version="1.0" encoding="utf-8"?>
<!--
  This manifest exists for the PackageInstaller result receiver. Installing our
  own APK kills this process, so a runtime-registered receiver would die with it
  and lose EXTRA_STATUS_MESSAGE (the only explanation of an "app not installed"
  without adb). Declared here, the system recreates the process to deliver it.

  The update permissions live in :app: declaring REQUEST_INSTALL_PACKAGES in a
  library module would spread it to every app that consumes :data.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      This module calls ConnectivityManager (DeviceNetwork), so it declares the
      permission it needs instead of relying on every consumer. It is read-only
      and harmless to propagate.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The deploy progress worker runs in the foreground with
      FOREGROUND_SERVICE_TYPE_DATA_SYNC. Since Android 14 the type must also be
      declared, or the system kills the worker with
      MissingForegroundServiceTypeException. Declared here because this module
      runs the worker.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>

        <!--
          The service belongs to WorkManager; this only merges the type into it.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!--
          exported="false": the only legitimate sender is the system, answering
          the explicit PendingIntent that ApkInstaller creates.
        -->
        <receiver
            android:name="com.vpsmanager.data.update.UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vpsmanager.data.update.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
        <!--
          The system installer is the last fallback of the update chain: when the
          PackageInstaller session is refused, the downloaded and verified APK goes
          to the standard install screen through a content:// Uri.

          The authority must be unique (like the terminal and WhatsApp providers):
          two FileProviders with the same authority in one APK fail installation
          with INSTALL_FAILED_CONFLICTING_PROVIDER.
        -->
        <provider
            android:name="com.vpsmanager.data.update.UpdateFileProvider"
            android:authorities="${applicationId}.atualizacao"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
