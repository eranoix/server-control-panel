<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Requested unconditionally at first post-login onboarding: minSdk 34 is already above
         API 33 where this was introduced, so no version gate is needed around the request. -->
    <!--
      The app updates itself through the incremental channel (a ~1.4 MB patch instead of the
      31 MB APK). Without this permission PackageInstaller never shows its dialog. The owner
      still has to allow "install unknown apps" for this app; the update banner links straight
      to that toggle when canRequestPackageInstalls() is false.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Updates without the system dialog. Normal permission (granted at install). It only takes
      effect when Android knows who installed the app; otherwise the update fails with "Self
      update is blocked by unknown source package". Consent moves to the in-app "Update" tap,
      which avoids the second system prompt where Samsung's Auto Blocker interrupts.
    -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!--
      Reopens the app after it updates itself. Starting an activity from a receiver is a
      background activity start, which Android blocks silently. Measured on the emulator: a
      direct startActivity and a PendingIntent with creator and sender opt-in are both blocked
      (the receiver has no visible window); only SYSTEM_ALERT_WINDOW works.
      Optional: without it, the return happens through a one-tap notification, so it is asked
      for with an explanation and never required.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Read-only network state, used to tell the user whether data is live or cached. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Keeps the terminal alive in the background. Measured on Android 16: once the app leaves
      the foreground, the background firewall chain blocks the UID and destroys sockets after
      ~5.7 s. The battery optimization exemption is exactly the way out of that chain
      (allowed=POWER_SAVE_ALLOWLIST). The cached app freezer still stops the process at ~70 s,
      so the gain is ~6 s to ~70 s, enough to switch apps and come back without reconnecting.
      Never requested on its own or at first boot: it is an explained opt-in in the terminal
      options sheet.
      tools:ignore="BatteryLife": the lint warning is about Play Store policy, and this app is
      distributed through its own F-Droid repository.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Native incoming-call UI. CAMERA/RECORD_AUDIO are requested proactively
         from the room lobby before a call is joined, not at install time (RoomLobbyScreen). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Deploy tracking runs as a foreground worker. Since Android 14 a foreground service only
         starts if its type is declared and the type's permission is granted; without this the
         system kills the worker with MissingForegroundServiceTypeException. The type itself is
         declared by :data, which runs the worker. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Registers this app's self-managed PhoneAccount with Telecom (PhoneAccountRegistrar) so
         calls get native lock-screen UI, ringtone and DND bypass instead of a plain notification. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Lets an incoming call ring over the lock screen. This app is not Play-Store-distributed
         (self-hosted F-Droid repo), so it is exempt from Play's automated revocation of this
         permission; IncomingCallNotifier still surfaces a banner if the user manually revokes
         the per-app Settings toggle. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- All hardware is optional. A hardware permission alone implies a required feature, and
         stores hide the app from devices without it. This is a server operations app, so every
         feature is declared required="false" to keep it installable on tablets without a camera,
         Chromebooks and emulators; features that need the hardware degrade on their own.
         camera: only used for QR pairing (manual setup is a full alternative) and video calls.
         camera.autofocus: without it fixed-focus devices would still be filtered out.
         microphone: only used by video calls.
         telephony: calls are WebRTC over IP with self-managed Telecom; declared so a Wi-Fi-only
         tablet stays a valid target even if a future permission implies telephony. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".PanelApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
            supportsPictureInPicture (without the "Mode" suffix; AAPT rejects the longer name)
            keeps a call alive in a floating window while the user is in another app.
            configChanges is required with it: entering and leaving PiP changes size, orientation
            and density, and without it Android recreates the Activity on every transition,
            destroying the NavHost, the terminal socket and the call itself.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Home screen widget. Not exported: no other app needs to trigger its update, and the
            system itself instantiates it through APPWIDGET_UPDATE.
        -->
        <receiver
            android:name=".widget.HomeWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_info" />
        </receiver>

        <service
            android:name="dev.servercontrolpanel.feature.notifications.fcm.VpsFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- BIND_TELECOM_CONNECTION_SERVICE is enforced by the system, not this app: exported
             but only Telecom itself can bind to it. -->
        <service
            android:name="dev.servercontrolpanel.feature.videocall.call.PanelConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Not exported: only PanelConnection (same app) ever starts/stops this service. -->
        <service
            android:name="dev.servercontrolpanel.feature.videocall.call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|camera|microphone" />

        <!-- Android share target: lets another app hand server-control-panel a file
             (or several) or plain text directly through the system share sheet. `*/*`
             is deliberate: a file manager's share target should accept arbitrary file
             types the same way its manual upload does: narrowing the MIME type would
             silently exclude legitimate shares (e.g. a .tar.gz) with no requirement
             calling for that restriction. Exported unconditionally: any app's share
             sheet must be able to launch it, the same as any other share target. -->
        <activity
            android:name=".share.ShareTargetActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          Reopens the app after an update. MY_PACKAGE_REPLACED is delivered to this app when it
          is itself replaced, so it still works when declared in the manifest.
          Not exported: only the system fires it, so no other app can fake an update.
        -->
        <receiver
            android:name=".update.ReturnAfterUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Not exported: only this app's own notification PendingIntents ever target it
             (a spoofed broadcast from another app cannot reach this receiver). -->
        <receiver
            android:name="dev.servercontrolpanel.feature.notifications.fcm.NotificationActionReceiver"
            android:exported="false" />

    </application>

</manifest>
