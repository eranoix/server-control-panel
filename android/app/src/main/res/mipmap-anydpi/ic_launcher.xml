<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon with separate layers so the launcher can apply its own mask and parallax.
    `anydpi` with no version qualifier and no PNG fallback: minSdk 34 is above API 26
    (adaptive icons) and API 33 (monochrome).
    ic_launcher and ic_launcher_round share the same layers on purpose, since the launcher
    applies the mask; `roundIcon` stays in the manifest because older launchers look it up.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
