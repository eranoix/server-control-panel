<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground layer of the adaptive icon: the same mark as
    internal/webassets/web/logo-mark.svg, so the app and the web panel read as one product.

    The SVG cuts the spine and wedges with a <mask>, which VectorDrawable lacks; a single
    path with fillType="evenOdd" gives the same holes because the subshapes lie fully inside
    the hexagon.

    Safe zone: only the central 66dp circle survives every launcher mask. The logo lives in a
    64 viewport centered at (32,32) with a circumradius of 28; the group scales by 30/28 and
    translates by 22, centering it at (54,54) with a 30dp radius (3dp margin each side).
    The path data is kept literal so it can be compared line by line with logo-mark.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="32"
        android:pivotY="32"
        android:scaleX="1.0714286"
        android:scaleY="1.0714286"
        android:translateX="22"
        android:translateY="22">
        <path
            android:fillColor="#22D3EE"
            android:fillType="evenOdd"
            android:pathData="M32,4 L52,15 L56,32 L52,49 L32,60 L12,49 L8,32 L12,15 Z M29,19 A3,3 0 0 1 35,19 L35,45 A3,3 0 0 1 29,45 Z M17,20 L27,20 L27,26 L21,30 L15,27 Z M47,44 L37,44 L37,38 L43,34 L49,37 Z" />
    </group>
</vector>
