<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest: AGP merges it only into the `debug` variant, so nothing here reaches a
  published APK.
  usesCleartextTraffic makes the server setup's "Allow http:// (local development only)"
  option actually work (Android blocks cleartext by default since targetSdk 28), so the app
  can point at a local server such as `http://10.0.2.2:<port>` on the emulator.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true" />

</manifest>
