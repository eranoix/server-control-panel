<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility (Android 11+): without this block
      `queryIntentActivities` for ACTION_PROCESS_TEXT returns an empty list, and the
      terminal selection overflow menu would lack "Translate", "Search" and other
      text actions from installed apps. Declared here because this module runs the
      query; manifest merging carries it into the APK.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <!--
      Terminal attachment "take a photo now": the camera app writes into the file
      we point at, so it needs a writable `content://` URI (a `file://` would throw
      FileUriExposedException). exported="false" + grantUriPermissions="true" means
      access only comes from the explicit grant the TakePicture contract attaches.
      The scope in xml/terminal_attach_paths.xml is one cache subfolder.

      The authority has its own prefix (`terminalattach`) so it never collides with
      :feature-whatsapp's FileProvider: duplicate authorities make installation fail.
      The CAMERA permission is declared by :app.
    -->
    <application>
        <provider
            android:name="com.vpsmanager.feature.terminal.attach.AttachmentFileProvider"
            android:authorities="${applicationId}.terminalattach.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/terminal_attach_paths" />
        </provider>
    </application>

</manifest>
