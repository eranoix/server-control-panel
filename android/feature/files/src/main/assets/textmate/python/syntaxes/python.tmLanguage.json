{
  "name": "Python",
  "scopeName": "source.python",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.python"
    },
    "strings": {
      "patterns": [
        { "begin": "(?i:[rbuf]{0,2})\"\"\"", "end": "\"\"\"", "name": "string.quoted.triple.python" },
        { "begin": "(?i:[rbuf]{0,2})'''", "end": "'''", "name": "string.quoted.triple.python" },
        { "match": "(?i:[rbuf]{0,2})\"(?:[^\"\\\\\\n]|\\\\.)*\"", "name": "string.quoted.double.python" },
        { "match": "(?i:[rbuf]{0,2})'(?:[^'\\\\\\n]|\\\\.)*'", "name": "string.quoted.single.python" }
      ]
    },
    "numbers": {
      "match": "\\b0[xX][0-9a-fA-F]+\\b|\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.python"
    },
    "constants": {
      "match": "\\b(True|False|None)\\b",
      "name": "constant.language.python"
    },
    "keywords": {
      "match": "\\b(and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)\\b",
      "name": "keyword.control.python"
    }
  }
}
