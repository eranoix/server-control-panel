<?xml version="1.0" encoding="utf-8"?>
<!--
  This module owns both call services, so they are declared here and not in `:app`.
  The module's instrumented test APK merges only src/main and src/androidTest, never
  the `:app` manifest, so without these declarations the services cannot start in tests.
  Permissions live next to the services that use them; AGP merges them with the
  identical ones `:app` still declares.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CallForegroundService runs with type phoneCall|camera|microphone; since
         Android 14 each type needs its own FOREGROUND_SERVICE_* permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- The camera/microphone types require CAMERA/RECORD_AUDIO to be GRANTED at
         startForeground() time or the system throws SecurityException. Requested in
         RoomLobbyScreen and rechecked by PanelConnection.onAnswer. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Self-managed Telecom account: gives native call UI, ringing and DND bypass. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- Lets the call ring over the lock screen; IncomingCallNotifier detects a
         manual revocation and shows a banner. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application>

        <!-- Exported, but BIND_TELECOM_CONNECTION_SERVICE is system-enforced, so only
             Telecom can bind. -->
        <service
            android:name="dev.servercontrolpanel.feature.videocall.call.PanelConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Not exported: only PanelConnection and CallViewModel start and stop it. -->
        <service
            android:name="dev.servercontrolpanel.feature.videocall.call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|camera|microphone" />

    </application>

</manifest>
