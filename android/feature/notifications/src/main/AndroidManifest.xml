<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- This module posts notifications, so it declares the permission itself and
         its isolated lint sees it. The runtime request (required since Android 13)
         lives in `PushOnboarding`, after login. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
