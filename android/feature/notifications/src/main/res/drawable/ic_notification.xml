<?xml version="1.0" encoding="utf-8"?>
<!--
    Status bar notification icon: the vps-manager mark (same as logo-mark.svg).

    The xmlns must be ".../apk/res/android"; a typo compiles silently with aapt2 but
    the vector then fails to inflate at runtime.

    Must be a SILHOUETTE: Android discards colour and repaints the shape in the theme
    colour, so only alpha matters (opaque hexagon, transparent evenOdd cutouts and
    surroundings). A coloured or filled icon shows as a grey square.

    The group scales the mark (56 units tall in a 64 viewport) to 20dp inside the
    24dp frame, centred at (12,12), leaving about 2dp of padding.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <group
        android:pivotX="32"
        android:pivotY="32"
        android:scaleX="0.3571429"
        android:scaleY="0.3571429"
        android:translateX="-20"
        android:translateY="-20">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M32,4 L52,15 L56,32 L52,49 L32,60 L12,49 L8,32 L12,15 Z M29,19 A3,3 0 0 1 35,19 L35,45 A3,3 0 0 1 29,45 Z M17,20 L27,20 L27,26 L21,30 L15,27 Z M47,44 L37,44 L37,38 L43,34 L49,37 Z" />
    </group>
</vector>
