# Build outputs
bin/
*.exe
*.test
*.out

# Runtime data (audit logs, sessions, queue state, secrets vault, etc.)
# Anchored at the root: an unanchored "data/" would also hide android/data/.
/data/

# Gradle: local cache and build output. **/.gradle/ because android/build-logic/
# is an included build with its own .gradle/ cache.
android/**/.gradle/
android/**/build/
android/local.properties

# Kotlin 2.x project-level compiler cache.
android/**/.kotlin/

# Scratch checkout of the pinned ghostty commit + zig build cache, recreated
# by build-libghostty.sh (the committed artifact is vendor/).
android/terminal-engine/.build/

# CMake/ninja externalNativeBuild intermediates for :terminal-engine's JNI
# shim (src/main/cpp), regenerated by Gradle.
android/terminal-engine/.cxx/

# :patch-engine scratch (HDiffPatch checkout, host hdiffz, fixture APKs),
# recreated by vendor-hdiffpatch.sh and tools/make-patch-fixtures.sh. The
# committed artifact is vendor/, listed in vendor-files.txt.
android/patch-engine/.build/

# ndk-build/externalNativeBuild intermediates of :patch-engine.
android/patch-engine/.cxx/

# Tailwind CSS standalone binary (41MB), restored by scripts/build-tailwind.sh
scripts/tailwindcss
scripts/tailwind

# Node.js (browser/ subdir uses Node)
browser/node_modules/
browser/data/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
*~

# Planning state (live workflow files, not source)
.planning/HANDOFF.json
.planning/STATE.md
# These contain secrets: never commit.
.planning/vpsm-48-tactiq-apps-script.js
.planning/.pending-auth-captures.jsonl

# Local agent tooling state
.claude/projects/
.claude/todos/
# Session handovers are rewritten on every turn; tracking them keeps the tree dirty.
.claude/sessions/

# Temporary
*.tmp
*.log
deploy.log

# agentctl runtime coordination state (per host). invariants.txt IS committed.
.claude/coord/board.json
.claude/coord/messages.jsonl
.claude/coord/deploys.jsonl
.claude/coord/*.cursor
.claude/coord/.lock
.claude/coord/.deploylock
.claude/coord/agentctl.env
.claude/coord/pending-push.log

# Generated knowledge graph. No trailing slash: in worktrees graphify-out is a
# symlink, and a directory-only pattern would let it be committed.
graphify-out

# Local build tooling (esbuild for make minify). The second line covers the
# symlink that ticket worktrees use instead of a directory.
.tools/
.tools
# Generated by `make minify` on every build and embedded from disk at compile time.
internal/webassets/web/vendor/vpsm/app/*.min.js
android/graphify-out/

# Raw logcat from the terminal soak run (23 MB per run); the summary lives in
# SOAK-REPORT.md.
.planning/phases/*/soak-logcat.txt
